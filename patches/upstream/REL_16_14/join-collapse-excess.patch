 static void deconstruct_distribute(PlannerInfo *root, JoinTreeItem *jtitem);
 static void process_security_barrier_quals(PlannerInfo *root,
 										   int rti, JoinTreeItem *jtitem);
@@ -775,6 +784,14 @@ deconstruct_jointree(PlannerInfo *root)
 	/* ... which should match what we computed for the top join domain */
 	Assert(bms_equal(root->all_query_rels, top_jdomain->jd_relids));
 
+	/*
+	 * Now that the whole jointree has been scanned, we know which subproblems
+	 * join_collapse_limit kept us from flattening, and can report that once
+	 * for the query if the user asked us to.
+	 */
