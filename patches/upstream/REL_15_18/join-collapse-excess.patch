+/*
+ * join_collapse_item_names
+ *	  Build a comma-separated, quoted list of the FROM items in the given relid
+ *	  set, and return the number of items named in *nitems.
+ *
+ * The set (a join subproblem's qualscope) may include join RTEs and other
+ * non-scan entries.  We switch over every RTEKind, with no default, so that
+ * the relations we name are chosen explicitly and so that adding a future
+ * RTEKind forces a compile-time decision here rather than silently changing
+ * the output.
+ */
+static char *
+join_collapse_item_names(PlannerInfo *root, Relids relids, int *nitems)
+{
+	StringInfoData buf;
+	int			relid = -1;
+
+	*nitems = 0;
+	initStringInfo(&buf);
+	while ((relid = bms_next_member(relids, relid)) >= 0)
+	{
+		RangeTblEntry *rte = planner_rt_fetch(relid, root);
+
+		switch (rte->rtekind)
+		{
+			case RTE_RELATION:
+			case RTE_SUBQUERY:
+			case RTE_FUNCTION:
+			case RTE_TABLEFUNC:
+			case RTE_VALUES:
+			case RTE_CTE:
+			case RTE_NAMEDTUPLESTORE:
+			case RTE_RESULT:
+				/* a FROM-list item the planner must join: name it */
+				if (*nitems > 0)
+					appendStringInfoString(&buf, ", ");
+				appendStringInfo(&buf, "\"%s\"", rte->eref->aliasname);
+				(*nitems)++;
+				break;
+
+			case RTE_JOIN:
+
+				/*
+				 * Not a FROM-list item: RTE_JOIN is a join's output-column
+				 * artifact, whose base relations are already named in their
+				 * own right.
+				 */
+				break;
+		}
+	}
+	return buf.data;
+}
+
+/*
+ * report_join_collapse_excess
+ *	  Report, per join_collapse_limit_excess, that join_collapse_limit stopped
+ *	  the planner from flattening part of the jointree.
+ *
+ * A chain of explicit joins crosses the limit once per JoinExpr, so several
+ * subproblems may be recorded for one query.  Reporting all of them would
+ * bury the user in near-duplicate messages, since each one's items are
+ * contained in the next.  Report only the subproblems that no other recorded
+ * subproblem encloses: a chain therefore yields a single report naming its
+ * outermost construct, while subproblems independent of one another are each
+ * reported in their own right.
+ *
+ * root->join_collapse_excess_scopes is built bottom-up, so an enclosing
+ * subproblem always appears later in the list than the ones it encloses.
+ * Comparing only against later scopes also settles the case of two recorded
+ * subproblems with equal qualscopes, where a plain subset test would discard
+ * both.
+ */
+static void
+report_join_collapse_excess(PlannerInfo *root)
+{
+	ListCell   *lc;
+
+	foreach(lc, root->join_collapse_excess_scopes)
+	{
+		Relids		scope = (Relids) lfirst(lc);
+		ListCell   *lc2;
+		bool		enclosed = false;
+		char	   *itemnames;
+		int			nitems;
+
+		/* Skip it if some enclosing subproblem was recorded as well */
+		for_each_cell(lc2, root->join_collapse_excess_scopes,
+					  lnext(root->join_collapse_excess_scopes, lc))
+		{
+			Relids		outer = (Relids) lfirst(lc2);
+
+			if (bms_is_subset(scope, outer))
+			{
+				enclosed = true;
+				break;
+			}
+		}
+		if (enclosed)
+			continue;
+
+		itemnames = join_collapse_item_names(root, scope, &nitems);
+
+		ereport(join_collapse_limit_excess == JOIN_COLLAPSE_LIMIT_EXCESS_ERROR ?
+				ERROR : WARNING,
+				(errcode(ERRCODE_PROGRAM_LIMIT_EXCEEDED),
+				 errmsg("join order optimization stopped because join_collapse_limit (%d) was exceeded",
+						join_collapse_limit),
+				 errdetail("Optimizing the join order of %s would require considering %d items together.",
+						   itemnames, nitems),
+				 errhint("Increase join_collapse_limit to at least %d to let the planner choose the join order for these items.",
+						 nitems)));
+	}
+}
+
