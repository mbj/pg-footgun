diff --git a/src/test/regress/expected/join_collapse_limit_excess.out b/src/test/regress/expected/join_collapse_limit_excess.out
new file mode 100644
index 00000000000..8f697bcaf61
--- /dev/null
+++ b/src/test/regress/expected/join_collapse_limit_excess.out
@@ -0,0 +1,259 @@
+--
+-- JOIN_COLLAPSE_LIMIT_EXCESS
+--
+-- Exercise the join_collapse_limit_excess GUC, which selects what happens when
+-- the planner stops flattening explicit JOIN constructs because doing so would
+-- exceed join_collapse_limit: stay silent (off), emit a WARNING (warn), or
+-- raise an ERROR (error).  In the warn/error cases the base relations of the
+-- subproblem that could not be flattened are reported.
+--
+CREATE TEMP TABLE table_a (id int);
+CREATE TEMP TABLE table_b (id int);
+CREATE TEMP TABLE table_c (id int);
+-- Default is off.
+SHOW join_collapse_limit_excess;
+ join_collapse_limit_excess 
+----------------------------
+ off
+(1 row)
+
+-- Only off/warn/error are accepted.
+SET join_collapse_limit_excess = 'bogus';
+ERROR:  invalid value for parameter "join_collapse_limit_excess": "bogus"
+HINT:  Available values: off, warn, error.
+-- Make the limit small so a modest explicit join exceeds it.
+SET join_collapse_limit = 2;
+-- A two-way join stays within the limit: no diagnostic even in error mode.
+SET join_collapse_limit_excess = 'error';
+SELECT * FROM table_a JOIN table_b USING (id);
+ id 
+----
+(0 rows)
+
+-- A three-way explicit join exceeds join_collapse_limit = 2.
+-- warn: reports the relations but still plans and runs the query.
+SET join_collapse_limit_excess = 'warn';
+SELECT * FROM table_a JOIN table_b USING (id) JOIN table_c USING (id);
+WARNING:  join order optimization stopped because join_collapse_limit (2) was exceeded
+DETAIL:  Optimizing the join order of "table_a", "table_b", "table_c" would require considering 3 items together.
+HINT:  Increase join_collapse_limit to at least 3 to let the planner choose the join order for these items.
+ id 
+----
+(0 rows)
+
+-- error: the same query is rejected before execution.
+SET join_collapse_limit_excess = 'error';
+SELECT * FROM table_a JOIN table_b USING (id) JOIN table_c USING (id);
+ERROR:  join order optimization stopped because join_collapse_limit (2) was exceeded
+DETAIL:  Optimizing the join order of "table_a", "table_b", "table_c" would require considering 3 items together.
+HINT:  Increase join_collapse_limit to at least 3 to let the planner choose the join order for these items.
+-- off: the historical behavior, silent.
+SET join_collapse_limit_excess = 'off';
+SELECT * FROM table_a JOIN table_b USING (id) JOIN table_c USING (id);
+ id 
+----
+(0 rows)
+
+-- The reported set includes non-table FROM items such as an
+-- optimization-fenced subquery, named by the alias SQL requires for it.
+SET join_collapse_limit_excess = 'error';
+SELECT * FROM table_a JOIN table_b USING (id)
+  JOIN (SELECT id FROM table_c OFFSET 0) subquery USING (id);
+ERROR:  join order optimization stopped because join_collapse_limit (2) was exceeded
+DETAIL:  Optimizing the join order of "table_a", "table_b", "subquery" would require considering 3 items together.
+HINT:  Increase join_collapse_limit to at least 3 to let the planner choose the join order for these items.
+-- A FULL JOIN forces the join order independently of join_collapse_limit, so it
+-- must not trigger the diagnostic.
+SET join_collapse_limit_excess = 'error';
+SELECT * FROM table_a FULL JOIN table_b USING (id) FULL JOIN table_c USING (id);
+ id 
+----
+(0 rows)
+
+-- The check runs during planning, so it also applies to queries planned via
+-- SPI (here, PL/pgSQL), and the error is a normal, trappable exception with
+-- SQLSTATE program_limit_exceeded.
+SET join_collapse_limit_excess = 'error';
+DO $$
+BEGIN
+  PERFORM * FROM table_a JOIN table_b USING (id) JOIN table_c USING (id);
+EXCEPTION WHEN program_limit_exceeded THEN
+  RAISE NOTICE 'caught program_limit_exceeded from join_collapse_limit_excess';
+END $$;
+NOTICE:  caught program_limit_exceeded from join_collapse_limit_excess
+-- The planner reaches the collapse decision once per JoinExpr, so a chain of
+-- explicit joins crosses the limit once per join as it is walked.  Only the
+-- outermost such subproblem is reported, so the chain yields one diagnostic
+-- however long it is, and the relation count reported matches the number of
+-- relations named.
+CREATE TEMP TABLE table_d (id int);
+CREATE TEMP TABLE table_e (id int);
+SET join_collapse_limit_excess = 'warn';
+SELECT * FROM table_a JOIN table_b USING (id) JOIN table_c USING (id);
+WARNING:  join order optimization stopped because join_collapse_limit (2) was exceeded
+DETAIL:  Optimizing the join order of "table_a", "table_b", "table_c" would require considering 3 items together.
+HINT:  Increase join_collapse_limit to at least 3 to let the planner choose the join order for these items.
+ id 
+----
+(0 rows)
+
+SELECT * FROM table_a JOIN table_b USING (id) JOIN table_c USING (id)
+  JOIN table_d USING (id);
+WARNING:  join order optimization stopped because join_collapse_limit (2) was exceeded
+DETAIL:  Optimizing the join order of "table_a", "table_b", "table_c", "table_d" would require considering 4 items together.
+HINT:  Increase join_collapse_limit to at least 4 to let the planner choose the join order for these items.
+ id 
+----
+(0 rows)
+
+SELECT * FROM table_a JOIN table_b USING (id) JOIN table_c USING (id)
+  JOIN table_d USING (id) JOIN table_e USING (id);
+WARNING:  join order optimization stopped because join_collapse_limit (2) was exceeded
+DETAIL:  Optimizing the join order of "table_a", "table_b", "table_c", "table_d", "table_e" would require considering 5 items together.
+HINT:  Increase join_collapse_limit to at least 5 to let the planner choose the join order for these items.
+ id 
+----
+(0 rows)
+
+-- error reports the same subproblem that warn does.
+SET join_collapse_limit_excess = 'error';
+SELECT * FROM table_a JOIN table_b USING (id) JOIN table_c USING (id)
+  JOIN table_d USING (id) JOIN table_e USING (id);
+ERROR:  join order optimization stopped because join_collapse_limit (2) was exceeded
+DETAIL:  Optimizing the join order of "table_a", "table_b", "table_c", "table_d", "table_e" would require considering 5 items together.
+HINT:  Increase join_collapse_limit to at least 5 to let the planner choose the join order for these items.
+-- That collapsing happens once per planning problem, not once per statement.
+-- A subquery that cannot be pulled up is planned on its own, so it is scanned
+-- for collapsing on its own and reported on its own.  Here two optimization
+-- fences each exceed the limit, and one statement yields two diagnostics.
