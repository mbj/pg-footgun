diff --git a/src/include/optimizer/planmain.h b/src/include/optimizer/planmain.h
index 6f87ee3258d..5c101135218 100644
--- a/src/include/optimizer/planmain.h
+++ b/src/include/optimizer/planmain.h
@@ -61,11 +61,26 @@ extern Limit *make_limit(Plan *lefttree, Node *limitOffset, Node *limitCount,
 						 AttrNumber *uniqColIdx, Oid *uniqOperators,
 						 Oid *uniqCollations);
 
+/*
+ * How strictly to react when join_collapse_limit is exceeded, i.e. when the
+ * planner stops flattening explicit JOIN constructs because doing so would
+ * produce a FROM-list larger than join_collapse_limit.  This is historically
+ * silent (JOIN_COLLAPSE_LIMIT_EXCESS_OFF); the other modes make it
+ * observable or turn it into a hard error.
+ */
+typedef enum
+{
+	JOIN_COLLAPSE_LIMIT_EXCESS_OFF, /* silently stop collapsing (default) */
+	JOIN_COLLAPSE_LIMIT_EXCESS_WARN,	/* stop collapsing, emit a WARNING */
+	JOIN_COLLAPSE_LIMIT_EXCESS_ERROR,	/* raise an ERROR instead */
+} JoinCollapseLimitExcess;
+
 /*
  * prototypes for plan/initsplan.c
  */
 extern PGDLLIMPORT int from_collapse_limit;
 extern PGDLLIMPORT int join_collapse_limit;
+extern PGDLLIMPORT int join_collapse_limit_excess;
 
 extern void add_base_rels_to_query(PlannerInfo *root, Node *jtnode);
 extern void add_other_rels_to_query(PlannerInfo *root);
